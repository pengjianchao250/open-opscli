# opscli 环境变量配置示例
# 复制此文件为 .env 并按需修改，.env 文件不会提交到 git
#
# 优先级：.env > ~/.config/opscli/config.ini > 代码默认值
# 留空或不设置则使用下一层的值

# ops 系统 API 地址（含 /api 后缀）
# OPSCLI_OPS_URL=https://ops.api.xenkee.com/api

# ops 系统基础 URL（不含 /api，用于 MCP API Key 校验等）
# OPSCLI_OPS_SYSTEM_URL=https://ops.api.xenkee.com

# ops 系统 CLI Token 获取端点
# OPSCLI_OPS_TOKEN_ENDPOINT=/api/v1/auth/cli-token

# polaris 系统基础 URL
# OPSCLI_POLARIS_SYSTEM_URL=https://bi.api.xenkee.com

# polaris 系统 CLI Token 获取端点
# OPSCLI_POLARIS_TOKEN_ENDPOINT=/api/auth/cli-token

# Amazon 提交端点（留空则不启用）
# OPSCLI_AMAZON_SUBMIT_ENDPOINT=

# 是否启用 polaris 系统参与授权请求和 Token 刷新（true/false）
# OPSCLI_POLARIS_ENABLED=false

# ---- 测试/开发环境示例 ----
# OPSCLI_OPS_URL=http://localhost/api
# OPSCLI_OPS_SYSTEM_URL=http://localhost
# OPSCLI_OPS_TOKEN_ENDPOINT=/api/v1/auth/cli-token
# OPSCLI_POLARIS_SYSTEM_URL=http://localhost:8080
# OPSCLI_POLARIS_TOKEN_ENDPOINT=/api/auth/cli-token
# OPSCLI_POLARIS_ENABLED=true
