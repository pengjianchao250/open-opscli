# opscli 环境变量配置示例
# 复制此文件为 .env 并按需修改，.env 文件不会提交到 git
#
# 优先级：.env > ~/.config/opscli/config.ini > 代码默认值
# 留空或不设置则使用下一层的值

# ops 系统 API 地址（含 /api 后缀）
# OPSCLI_OPS_URL=https://ops.api.xenkee.com/api

# ops 系统基础 URL（不含 /api，用于 MCP API Key 校验等）
# OPSCLI_OPS_SYSTEM_URL=https://ops.api.xenkee.com

# ops 系统 CLI Token 获取端点
# OPSCLI_OPS_TOKEN_ENDPOINT=/api/v1/auth/cli-token

# polaris 系统基础 URL
# OPSCLI_POLARIS_SYSTEM_URL=https://bi.api.xenkee.com

# polaris 系统 CLI Token 获取端点
# OPSCLI_POLARIS_TOKEN_ENDPOINT=/api/auth/cli-token

# Amazon 提交端点（留空则不启用）
# OPSCLI_AMAZON_SUBMIT_ENDPOINT=

# 是否启用 polaris 系统参与授权请求和 Token 刷新（true/false）
# OPSCLI_POLARIS_ENABLED=false

# ---- Collector 数据沉淀（仅 opscli-collector-mcp 使用） ----
# 默认关闭；启用后环境必须显式设置为 production 或 debug，不能从目录名推断
# OPSCLI_COLLECTOR_STORAGE_ENABLED=false
# OPSCLI_DATA_ENVIRONMENT=production
# OPSCLI_COLLECTOR_STORAGE_SQLITE_PATH=~/.config/opscli/collector/collection_storage.sqlite3

# MySQL 密码生产环境应由 Secret/systemd 凭据注入，不要提交真实值
# OPSCLI_COLLECTOR_MYSQL_HOST=mysql.internal
# OPSCLI_COLLECTOR_MYSQL_PORT=3306
# OPSCLI_COLLECTOR_MYSQL_DATABASE=polaris_ops_mcp
# OPSCLI_COLLECTOR_MYSQL_USER=collector_writer
# OPSCLI_COLLECTOR_MYSQL_PASSWORD=
# 生产环境必填，用于验证 MySQL 服务端证书和主机身份；debug 可留空
# OPSCLI_COLLECTOR_MYSQL_SSL_CA=/etc/opscli/mysql-ca.pem

# 空库首次初始化时临时启用并使用具备 DDL 权限的迁移账号；建表后关闭并切回 writer
# OPSCLI_COLLECTOR_STORAGE_AUTO_CREATE_SCHEMA=false
# OPSCLI_COLLECTOR_STORAGE_BATCH_SIZE=500
# OPSCLI_COLLECTOR_STORAGE_POLL_INTERVAL_SECONDS=2
# OPSCLI_COLLECTOR_STORAGE_RECONCILE_INTERVAL_SECONDS=60
# OPSCLI_COLLECTOR_STORAGE_LEASE_SECONDS=300

# ---- Collector Monitor 监控服务 ----
# Monitor 只读取进程环境，不会自动加载 .env 或 config.ini；请由 Shell、systemd 或部署工具显式导入
# 默认仅监听本机；对外开放时必须使用受控反向代理、TLS 和认证
# OPSCLI_COLLECTOR_MONITOR_HOST=127.0.0.1
# OPSCLI_COLLECTOR_MONITOR_PORT=8767

# SellerSprite 与 Monitor 必须使用同一业务队列路径；生产环境建议显式配置绝对路径
# Monitor 对业务队列严格只读，私有状态库可写，二者不能指向同一物理文件
# OPSCLI_SELLER_SPRITE_QUEUE_DB_PATH=~/.config/opscli/seller_sprite/task_queue.sqlite3
# 兼容变量可省略；如同时配置，必须与上面的 SellerSprite 路径一致
# OPSCLI_COLLECTOR_MONITOR_QUEUE_DB_PATH=~/.config/opscli/seller_sprite/task_queue.sqlite3
# OPSCLI_COLLECTOR_MONITOR_STATE_DB_PATH=~/.config/opscli/collector_monitor/state.sqlite3

# CLI 查询 Monitor 使用的基址；不包含凭据、查询串或 fragment
# 页面会接收 API Key，因此非回环地址必须使用 HTTPS
# OPSCLI_COLLECTOR_MONITOR_URL=http://127.0.0.1:8767

# 可选 Collector MCP 手动健康探测；页面自动刷新不会发起此探测
# 服务端持久 API Key 原文不得写入 .env，只能配置权限受限文件路径；页面可选择仅在浏览器 localStorage 保存
# 配置 API Key 文件或启用场景测试时，远端 URL 必须使用 HTTPS；仅明确回环地址允许 HTTP
# 携带 API Key 时禁止自动跟随 HTTP 重定向；密钥文件读取与远端调用共用探测总超时
# OPSCLI_COLLECTOR_MONITOR_COLLECTOR_MCP_URL=https://collector.example/mcp
# OPSCLI_COLLECTOR_MONITOR_COLLECTOR_MCP_API_KEY_FILE=~/.config/opscli/collector_monitor/collector-mcp.key
# OPSCLI_COLLECTOR_MONITOR_COLLECTOR_PROBE_TIMEOUT=5

# 可选真实场景测试，默认关闭；启用时必须同时配置 COLLECTOR_MCP_URL
# 仅允许页面提交固定 keyword-reverse（关键词反查），会消耗真实卖家精灵额度
# 场景提交必须显式提供页面 API Key，不能借用 Monitor 的服务端 Key 文件
# OPSCLI_COLLECTOR_MONITOR_SCENARIO_TEST_ENABLED=false

# 扫描与健康判定阈值（秒）；数值必须有限，不接受 NaN 或 Infinity
# OPSCLI_COLLECTOR_MONITOR_POLL_INTERVAL=10
# OPSCLI_COLLECTOR_MONITOR_STALLED_THRESHOLD=300
# OPSCLI_COLLECTOR_MONITOR_QUEUE_THRESHOLD=300
# runtime 心跳年龄达到该阈值即视为失联
# OPSCLI_COLLECTOR_MONITOR_RUNTIME_STALE_THRESHOLD=300
# OPSCLI_COLLECTOR_MONITOR_ORPHAN_REQUIRED_SCANS=2
# OPSCLI_COLLECTOR_MONITOR_ALERT_COOLDOWN=1800

# 可选企业微信机器人 Webhook 受保护文件
# 文件内容为单行完整 HTTPS Webhook；原文不得写入 .env、命令参数或日志
# 默认自动读取项目内置机器人文件；环境变量可覆盖，空值可禁用
# OPSCLI_COLLECTOR_MONITOR_WEBHOOK_FILE=~/.config/opscli/collector_monitor/wecom-webhook

# ---- 测试/开发环境示例 ----
# OPSCLI_OPS_URL=http://localhost/api
# OPSCLI_OPS_SYSTEM_URL=http://localhost
# OPSCLI_OPS_TOKEN_ENDPOINT=/api/v1/auth/cli-token
# OPSCLI_POLARIS_SYSTEM_URL=http://localhost:8080
# OPSCLI_POLARIS_TOKEN_ENDPOINT=/api/auth/cli-token
# OPSCLI_POLARIS_ENABLED=true
