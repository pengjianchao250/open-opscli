{
  "version": 1,
  "servers": [
    {
      "id": "pnd",
      "enabled": true,
      "url": "http://10.0.0.10:8008/mcp",
      "transport": "streamable_http",
      "allow_private_networks": true,
      "auth": {
        "type": "header",
        "header_name": "Authorization",
        "value": "Basic REPLACE_WITH_PND_AUTHORIZATION"
      },
      "caller_identity": {
        "source": "email",
        "location": "header",
        "header_name": "X-Opscli-User-Email",
        "required": true
      },
      "limits": {
        "max_concurrent": 8,
        "max_concurrent_per_user": 2,
        "queue_timeout_seconds": 2,
        "failure_threshold": 5,
        "circuit_open_seconds": 60,
        "max_request_bytes": 262144,
        "max_response_bytes": 2097152
      },
      "tools": [
        {
          "remote_name": "list_available_datasets",
          "exposed_name": "ext_pnd_list_available_datasets",
          "description": "查询当前用户可访问的 PND 数据集目录。",
          "timeout_seconds": 30,
          "idempotent": true,
          "read_only": true,
          "destructive": false,
          "max_attempts": 2,
          "retry_delay_seconds": 0.1,
          "input_schema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "remote_name": "execute_readonly_sql",
          "exposed_name": "ext_pnd_execute_readonly_sql",
          "description": "执行经过服务端校验的 PND 只读 SQL。",
          "timeout_seconds": 30,
          "idempotent": true,
          "read_only": true,
          "destructive": false,
          "max_attempts": 2,
          "retry_delay_seconds": 0.1,
          "input_schema": {
            "type": "object",
            "properties": {
              "sql": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sql"
            ],
            "additionalProperties": false
          }
        },
        {
          "remote_name": "search_similar_terms",
          "exposed_name": "ext_pnd_search_similar_terms",
          "description": "按站点和搜索词查询相似搜索词。",
          "timeout_seconds": 30,
          "idempotent": true,
          "read_only": true,
          "destructive": false,
          "max_attempts": 2,
          "retry_delay_seconds": 0.1,
          "input_schema": {
            "type": "object",
            "properties": {
              "search_term": {
                "type": "string",
                "minLength": 1
              },
              "site": {
                "type": "string"
              },
              "top": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1100
              }
            },
            "required": [
              "search_term"
            ],
            "additionalProperties": false
          }
        },
        {
          "remote_name": "get_report_task_status",
          "exposed_name": "ext_pnd_get_report_task_status",
          "description": "查询 PND 报告任务状态。",
          "timeout_seconds": 30,
          "idempotent": true,
          "read_only": true,
          "destructive": false,
          "max_attempts": 2,
          "retry_delay_seconds": 0.1,
          "input_schema": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "task_id"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  ]
}
