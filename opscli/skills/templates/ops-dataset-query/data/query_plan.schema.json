{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opscli.local/schemas/ops-dataset-query/query_plan.schema.json",
  "title": "ops-dataset-query Model Query Plan",
  "type": "object",
  "required": [
    "contract",
    "query_mode",
    "data_state",
    "metadata_version",
    "status",
    "model_view",
    "answer_contract",
    "execution_ref"
  ],
  "properties": {
    "contract": {"const": "query_plan_model_contract_v2"},
    "query_mode": {
      "description": "执行路由：普通数据集查询或显式图表 UUID 查询",
      "enum": ["dataset_query", "chart_uuid"]
    },
    "data_state": {"type": "string"},
    "metadata_source": {
      "description": "元数据来源形状：skill_local（updater 刷新，data_state=ready）/ published_bundle（技能广场发布包，无 data_state 字段）；blocked 时为空串",
      "type": "string"
    },
    "metadata_version": {"type": "string"},
    "status": {
      "enum": ["planned", "clarify_required", "blocked"]
    },
    "model_view": {
      "type": "object",
      "required": [
        "dataset_name_zh",
        "dimensions",
        "metrics",
        "platform_semantic_members",
        "platform_filter_state",
        "clarification_reason_codes",
        "clarification_messages_zh",
        "next_action"
      ],
      "properties": {
        "dataset_name_zh": {"type": "string"},
        "dimensions": {"$ref": "#/$defs/string_array"},
        "metrics": {"$ref": "#/$defs/string_array"},
        "platform_semantic_members": {
          "description": "请求语义的中文标签（用户可见层只允许中文）",
          "$ref": "#/$defs/string_array"
        },
        "platform_effective_members": {
          "description": "当前账号权限枚举后本次实际执行的平台中文范围",
          "$ref": "#/$defs/string_array"
        },
        "platform_scope_disclosures_zh": {
          "description": "裸亚马逊默认 SC+VC 及部分权限降级时的强制披露",
          "$ref": "#/$defs/string_array"
        },
        "platform_filter_state": {
          "enum": ["unknown", "not_requested", "requires_permission_enum", "resolved", "blocked"]
        },
        "clarification_reason_codes": {"$ref": "#/$defs/string_array"},
        "clarification_messages_zh": {"$ref": "#/$defs/string_array"},
        "next_action": {"type": "string"},
        "time_scope_zh": {
          "description": "本地解析的时间口径中文描述（含对比期与默认口径提示）",
          "type": "string"
        },
        "recommended_dimensions": {
          "description": "无点名维度时的系统推荐（需向用户确认后采用）",
          "$ref": "#/$defs/string_array"
        },
        "recommended_metrics": {
          "description": "无点名指标时的系统推荐（需向用户确认后采用）",
          "$ref": "#/$defs/string_array"
        },
        "default_filters_zh": {
          "description": "数据集默认条件的中文披露，不写入执行 payload，由服务端权威应用",
          "$ref": "#/$defs/string_array"
        },
        "default_dataset_recommendation_zh": {
          "description": "未明确指定数据集时，对已授权且兼容的即时综合数据集推荐",
          "type": "object",
          "required": ["name_zh", "reason_zh", "confirmation_required"],
          "properties": {
            "name_zh": {"type": "string"},
            "reason_zh": {"type": "string"},
            "confirmation_required": {"const": true}
          },
          "additionalProperties": false
        },
        "dataset_candidates_zh": {
          "description": "澄清态候选数据集卡片：中文名 + 命中原因，供带选项提问",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name_zh", "reason_zh"],
            "properties": {
              "name_zh": {"type": "string"},
              "reason_zh": {"type": "string"},
              "summary_zh": {
                "description": "仅由当前 CSV 字段统计生成的候选区分摘要",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "unknown_requested_fields": {
          "description": "点名但未匹配到的字段回显",
          "$ref": "#/$defs/string_array"
        },
        "ambiguous_field_labels_zh": {
          "description": "自然语言同名多物理字段，禁止静默择一",
          "$ref": "#/$defs/string_array"
        },
        "pending_confirmations_zh": {
          "description": "默认时间或系统推荐字段等必须先确认的口径",
          "$ref": "#/$defs/string_array"
        },
        "field_suggestions_zh": {
          "description": "未知字段的近似候选建议（你是不是想要）",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requested", "candidates_zh"],
            "properties": {
              "requested": {"type": "string"},
              "candidates_zh": {"$ref": "#/$defs/string_array"}
            },
            "additionalProperties": false
          }
        },
        "recovery_command": {
          "description": "仅 status=blocked 且需要刷新元数据时出现：可直接执行的恢复命令原文",
          "type": "string"
        },
        "recovery_hint_zh": {
          "description": "与 recovery_command 配套的中文恢复指引",
          "type": "string"
        },
        "recovery_state": {
          "description": "刷新恢复状态：refresh_in_progress（后台刷新中，sleep 后重跑）/ refresh_failed（需手动刷新）",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "answer_contract": {
      "type": "object",
      "required": [
        "required_disclosures_zh",
        "forbidden_outputs_zh",
        "technical_identifiers_user_visible",
        "user_visible_language"
      ],
      "properties": {
        "required_disclosures_zh": {"$ref": "#/$defs/string_array"},
        "forbidden_outputs_zh": {"$ref": "#/$defs/string_array"},
        "technical_identifiers_user_visible": {"const": false},
        "user_visible_language": {"const": "zh-CN"}
      },
      "additionalProperties": false
    },
    "execution_ref": {
      "type": "object",
      "required": ["user_visible"],
      "properties": {
        "user_visible": {"const": false},
        "chart_uuid": {"type": "string"},
        "chart_uuid_candidates": {"$ref": "#/$defs/string_array"},
        "chart_action": {
          "enum": ["structure", "run", "dry_run", "document"]
        },
        "query_command": {"type": "string"},
        "run": {"type": "boolean"},
        "dry_run": {"type": "boolean"},
        "dataset_alias": {"type": ["string", "null"]},
        "table_id": {"type": ["string", "integer", "null"]},
        "platform_component_alias": {"type": ["string", "null"]},
        "platform_component_table_id": {"type": ["string", "integer", "null"]},
        "resolved_platform_values": {"$ref": "#/$defs/string_array"},
        "platform_semantic_keys": {
          "description": "平台语义成员的内部枚举名（构造引用，不向用户展示）",
          "$ref": "#/$defs/string_array"
        },
        "platform_enum_source": {
          "description": "枚举值来源：auto_enum_service 表示规划器已自动枚举回灌",
          "type": "string"
        },
        "platform_enum_command": {
          "description": "待枚举时可直接执行的枚举命令原文",
          "type": "string"
        },
        "platform_enum_return_hint_zh": {"type": "string"},
        "dimensions": {"$ref": "#/$defs/execution_fields"},
        "metrics": {"$ref": "#/$defs/execution_fields"},
        "date_fields": {
          "description": "授权日期字段引用（时间过滤与 dataComparison 的构造依据，无条件输出）",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field_name", "label_zh"],
            "properties": {
              "field_name": {"type": "string"},
              "label_zh": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "filter_components": {
          "description": "可用显式筛选组件引用（部门/国家等非平台筛选的合规枚举入口）",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field_name", "label_zh", "component_dataset_alias"],
            "properties": {
              "field_name": {"type": "string"},
              "label_zh": {"type": "string"},
              "component_dataset_alias": {"type": "string"},
              "component_table_id": {"type": ["string", "integer"]}
            },
            "additionalProperties": false
          }
        },
        "time_scope": {
          "description": "本地解析的绝对日期窗口（Asia/Shanghai）",
          "type": "object",
          "required": ["start", "end", "is_default"],
          "properties": {
            "start": {"type": "string"},
            "end": {"type": "string"},
            "is_default": {"type": "boolean"},
            "comparison_type": {"type": ["string", "null"]},
            "comparison_start": {"type": ["string", "null"]},
            "comparison_end": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "query_template": {
          "description": "可直接填充的正式查询 payload 骨架（实测形态）",
          "type": "object"
        },
        "query_template_fill_rules_zh": {"type": "string"}
        ,
        "default_filters": {
          "description": "服务端自动应用的默认条件执行引用，仅用于披露与审计",
          "type": "array",
          "items": {"$ref": "#/$defs/default_filter"}
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {"type": "string"}
    },
    "execution_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field_name", "label_zh", "is_formula", "is_snapshot"],
        "properties": {
          "field_name": {"type": "string"},
          "label_zh": {"type": "string"},
          "is_formula": {"type": "boolean"},
          "is_snapshot": {"type": "boolean"},
          "aggregation_policy": {"type": "string"},
          "selection_source": {
            "description": "recommended 表示系统推荐字段（用户未点名，采用前须确认）",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "default_filter": {
      "type": "object",
      "required": [
        "field_name",
        "label_zh",
        "operator",
        "values",
        "type",
        "filter_type",
        "filter_agg"
      ],
      "properties": {
        "field_name": {"type": "string"},
        "label_zh": {"type": "string"},
        "operator": {"type": "string"},
        "values": {"type": "array"},
        "type": {"type": "string"},
        "filter_type": {"type": "string"},
        "filter_agg": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
