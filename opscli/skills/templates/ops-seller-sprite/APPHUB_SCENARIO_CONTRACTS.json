      "params": {
        "keyword": {"type": "string", "min_length": 1},
        "brand": {"type": "string", "min_length": 1},
        "sellerName": {"type": "string", "min_length": 1},
        "asins": {"type": "string_list", "min_items": 1, "max_items": 20},
        "node": {"type": "string", "min_length": 1},
