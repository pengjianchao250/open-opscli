        "code_blocks": [
          {
            "language": "text",
            "code": "\u9009\u9879\uff1a\n  --dataset TEXT      dataset_alias\uff08\u4e0e --table-id \u4e8c\u9009\u4e00\uff09\n  --table-id INTEGER  table_id\uff08\u4e0e --dataset \u4e8c\u9009\u4e00\uff09\n  --skills-dir TEXT   \u6307\u5b9a Skill \u76ee\u5f55\uff08\u8986\u76d6\u9ed8\u8ba4\u68c0\u6d4b\u8def\u5f84\uff09\n  --pretty            \u683c\u5f0f\u5316 JSON \u8f93\u51fa"
          },
          {
            "language": "bash",
            "code": "# \u6309 alias \u8bfb\u53d6\nopscli query metadata --dataset sales_order_d --pretty\n\n# \u6309 table_id \u8bfb\u53d6\nopscli query metadata --table-id 123 --pretty"
          },
          {
            "language": "text",
            "code": "\u9009\u9879\uff1a\n  --dataset TEXT      dataset_alias\n  --table-id INTEGER  table_id\n  --dimension TEXT    \u7ef4\u5ea6\u5b9a\u4e49\uff1afield_name[:alias]\uff0c\u53ef\u91cd\u590d\n  --metric TEXT       \u6307\u6807\u5b9a\u4e49\uff1afield_name:aggregation[:alias]\uff0c\u53ef\u91cd\u590d\n  --where TEXT        \u7b5b\u9009\u6761\u4ef6\uff1afield|operator|value_json\uff0c\u53ef\u91cd\u590d\n  --where-json TEXT   where \u6761\u4ef6 JSON \u5b57\u7b26\u4e32\uff08\u4e0e --where \u4e92\u65a5\uff09\n  --where-file TEXT   where \u6761\u4ef6 JSON \u6587\u4ef6\u8def\u5f84\uff08\u4e0e --where \u4e92\u65a5\uff09\n  --order-by TEXT     \u6392\u5e8f\u5b9a\u4e49\uff1aexpr[:asc|desc]\uff0c\u53ef\u91cd\u590d\n  --limit INTEGER     \u8fd4\u56de\u884c\u6570\uff0c\u9ed8\u8ba4 20\n  --offset INTEGER    \u5206\u9875\u504f\u79fb\uff0c\u9ed8\u8ba4 0\n  --output TEXT       \u5c06\u6784\u9020\u7684 payload \u5199\u5165\u6307\u5b9a\u6587\u4ef6\n  --run               \u6784\u9020\u540e\u7acb\u5373\u6267\u884c\u67e5\u8be2\uff08\u4e0d\u5199\u6587\u4ef6\uff09\n  --skills-dir TEXT   \u6307\u5b9a Skill \u76ee\u5f55\n  --pretty            \u683c\u5f0f\u5316 JSON \u8f93\u51fa"
          },
          {
            "language": "bash",
            "code": "# \u6784\u9020 payload \u5e76\u5199\u5165\u6587\u4ef6\nopscli query build \\\n  --dataset sales_order_d \\\n  --dimension date_id \\\n  --dimension country_id:country \\\n  --metric order_cost:sum:total_cost \\\n  --where \"date_id|gte|\\\"2024-01-01\\\"\" \\\n  --order-by total_cost:desc \\\n  --limit 50 \\\n  --output /tmp/query.json \\\n  --pretty\n\n# \u6784\u9020\u540e\u76f4\u63a5\u6267\u884c\uff08\u7b49\u4ef7\u4e8e build + run\uff09\nopscli query build \\\n  --dataset sales_order_d \\\n  --dimension date_id \\\n  --metric order_cost:sum \\\n  --run --pretty"
          },
          {
            "language": "text",
            "code": "\u9009\u9879\uff1a\n  --payload TEXT   \u67e5\u8be2 JSON \u6587\u4ef6\u8def\u5f84\uff08\u5fc5\u586b\uff09\n  --pretty         \u683c\u5f0f\u5316 JSON \u8f93\u51fa"
          },
          {
            "language": "bash",
            "code": "opscli query run --payload /tmp/query.json --pretty"
          },
          {
            "language": "text",
            "code": "\u9009\u9879\uff1a\n  --force    \u5f3a\u5236\u91cd\u65b0\u62c9\u53d6\uff0c\u5373\u4f7f\u7248\u672c\u53f7\u4e0e\u8fdc\u7aef\u4e00\u81f4\n  --pretty   \u683c\u5f0f\u5316 JSON \u8f93\u51fa"
          },
          {
            "language": "bash",
            "code": "# \u68c0\u67e5\u662f\u5426\u6709\u66f4\u65b0\uff08\u901a\u8fc7 status \u547d\u4ee4\uff09\nopscli skills status --pretty\n\n# \u5347\u7ea7\u5230\u6700\u65b0\u7248\u672c\nopscli skills upgrade ops-dataset-query\n\n# \u5f3a\u5236\u91cd\u65b0\u62c9\u53d6\u6240\u6709\u6570\u636e\nopscli skills upgrade ops-dataset-query --force"
          },
          {
            "language": "bash",
            "code": "# 1. \u67e5\u770b\u6570\u636e\u96c6\u5143\u6570\u636e\uff0c\u4e86\u89e3\u53ef\u7528\u5b57\u6bb5\nopscli query metadata --dataset sales_order_d --pretty\n\n# 2. \u6784\u9020\u67e5\u8be2 payload\nopscli query build \\\n  --dataset sales_order_d \\\n  --dimension date_id \\\n  --metric order_cost:sum:total_cost \\\n  --limit 30 \\\n  --output /tmp/query.json\n\n# 3. \u6267\u884c\u67e5\u8be2\nopscli query run --payload /tmp/query.json --pretty\n\n# 4. \u6216\u8005\u4e00\u6b65\u5b8c\u6210\u6784\u9020 + \u6267\u884c\nopscli query build --dataset sales_order_d --dimension date_id --metric order_cost:sum --run --pretty\n\n# 5. \u672c\u5730\u6570\u636e\u8fc7\u671f\u65f6\u5347\u7ea7\nopscli skills upgrade ops-dataset-query"
          }
        ],
